{
  "title": "反杜林论",
  "mentor": "Engels",
  "slug": "fan-du-lin-lun",
  "version": 2,
  "reading": [
    {
      "title": "先看它在回应什么",
      "content": "《反杜林论》不是纯理论陈列，而是针对杜林主义在党内蔓延所做的系统批判。先抓住它的现实背景，再看它如何把批判和建构放在一起。"
    },
    {
      "title": "再看三大组成部分",
      "content": "全书把哲学、政治经济学、科学社会主义串成一条线。阅读时不要把它当成零散章节集合，而要看恩格斯怎样用同一本书搭出完整马克思主义框架。"
    },
    {
      "title": "重点抓住‘地图’感",
      "content": "这本书像一张马克思主义地图，不只是回答‘杜林错在哪’，也回答‘马克思主义整体怎么连起来’。"
    }
  ],
  "difficulty": [
    {
      "wrong": "反杜林论只是反对一个人",
      "correct": "正解：它针对的是杜林主义及其背后的小资产阶级改良倾向，批判对象是错误思潮，不是个人争执。"
    },
    {
      "wrong": "三大规律只是抽象口号",
      "correct": "正解：恩格斯是在系统说明辩证法的基本规律，这些表述后来成为马克思主义哲学的核心资源。"
    },
    {
      "wrong": "科学社会主义只是道德上的更好方案",
      "correct": "正解：恩格斯强调它建立在资本主义矛盾运动的科学分析上，不是诉诸道德愿望。"
    }
  ],
  "dialogue": [
    {
      "title": "它在回应的问题",
      "items": [
        "杜林主义者——把小资产阶级观点包装成科学社会主义。",
        "党内被‘体系’吸引的人——需要一个完整的反驳框架。"
      ]
    },
    {
      "title": "它在问每一个读者",
      "items": [
        "你是把马克思主义当口号，还是当完整体系？",
        "你能不能分清‘科学分析’和‘道德愿望’？"
      ]
    },
    {
      "title": "它在等你的回应",
      "content": "选一个看起来很完整、很‘体系化’的观点，检查它到底有没有历史依据和现实分析。"
    }
  ],
  "action": [
    {
      "title": "实验一：拆解一段‘道德社会主义’论证",
      "content": "找一段只讲公平、正义、不平等，但不谈生产关系和阶级矛盾的论述，按反杜林论的方法拆开。"
    },
    {
      "title": "实验二：画出三大组成部分",
      "content": "把哲学、政治经济学、科学社会主义各写成一句话，再画出它们之间如何互相支撑。"
    }
  ],
